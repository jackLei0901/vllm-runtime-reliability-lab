diff --git a/vllm/v1/engine/core_client.py b/vllm/v1/engine/core_client.py
--- a/vllm/v1/engine/core_client.py
+++ b/vllm/v1/engine/core_client.py
@@ -302,6 +302,9 @@ class EngineCoreClient(ABC):
     async def is_sleeping_async(self) -> bool:
         raise NotImplementedError
 
+    async def check_health_async(self) -> None:
+        raise NotImplementedError
+
     async def abort_requests_async(self, request_ids: list[str]) -> None:
         raise NotImplementedError
 
@@ -417,6 +420,10 @@ class InprocClient(EngineCoreClient):
     def is_sleeping(self) -> bool:
         return self.engine_core.is_sleeping()
 
+    async def check_health_async(self) -> None:
+        # In-process: always healthy if reachable (no IPC to hang).
+        return
+
     def execute_dummy_batch(self) -> None:
         self.engine_core.execute_dummy_batch()
 
@@ -1300,6 +1307,21 @@ class AsyncMPClient(MPClient):
     async def is_sleeping_async(self) -> bool:
         return await self.call_utility_async("is_sleeping")
 
+    async def check_health_async(self) -> None:
+        """Ping EngineCore via its UTILITY IPC path."""
+        timeout = envs.VLLM_HEALTH_CHECK_TIMEOUT
+        if timeout <= 0:
+            return
+        try:
+            await asyncio.wait_for(
+                self.call_utility_async("health_ping"), timeout=timeout
+            )
+        except asyncio.TimeoutError as error:
+            raise EngineDeadError(
+                f"EngineCore did not respond to health ping within {timeout}s. "
+                "It may be stuck in a long operation or hung."
+            ) from error
+
     async def execute_dummy_batch_async(self) -> None:
         await self.call_utility_async("execute_dummy_batch")
 
